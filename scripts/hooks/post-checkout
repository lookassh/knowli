#!/bin/sh
# Knowli / Umiem! — nowy worktree (dowolne narzędzie wołające `git worktree add`: Claude, Codex,
# Muse, ręcznie) dostaje .env i zależności. Instalacja raz na klon: `pnpm hooks:install`.
# Przy `git worktree add` poprzedni HEAD ($1) to same zera; zwykłe przełączenia gałęzi pomijamy.
case "$1" in
  *[!0]*) exit 0 ;;
esac

node scripts/setup-worktree.cjs || echo "[post-checkout] Konfiguracja worktree nie powiodła się — uruchom ręcznie: pnpm wt:setup" >&2
# Zawsze 0: błąd konfiguracji nie może przerwać tworzenia worktree w narzędziu, które go wywołało.
exit 0
