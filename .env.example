# .env.example — katalog zmiennych środowiskowych Knowli / Umiem!
#
# Skopiuj do pliku .env (gitignore go chroni) i uzupełnij sekrety.
# Klucze API nigdy nie trafiają do repo, czatu ani NEXT_PUBLIC_*.
#
# Kto czyta ten plik lokalnie:
# - Docker Compose (zadanie 11) czyta .env z korzenia repozytorium.
# - web (`pnpm --filter web dev`): Next.js sam czyta apps/web/.env.local,
#   plik z korzenia jest dla niego niewidoczny.
# - worker (`pnpm --filter worker start`): czyta wyłącznie zmienne shella —
#   wyeksportuj je przed startem (np. `set -a; . ./.env; set +a`).

# ── Baza danych ──────────────────────────────────────────────────────────────
# Wymagana zawsze: web, worker i migracje (drizzle.config.ts).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knowli

# ── Trwały wolumen mediów ────────────────────────────────────────────────────
# Worker zapisuje wygenerowane audio/obrazy, web wydaje gotowe pliki.
# Domyślnie ./data/media liczony względem katalogu roboczego KAŻDEGO procesu
# (apps/web i apps/worker to różne katalogi!) — lokalnie podaj jedną wspólną
# ścieżkę bezwzględną dla obu procesów.
MEDIA_ROOT=./data/media
UMIEM_MCP_ALLOWED_ORIGINS=

# ── Klucze providerów ────────────────────────────────────────────────────────
# Tylko worker: jeden klucz OpenAI dla LLM (materiał), TTS (audio) i obrazów.
# Bez niego worker nie wystartuje, chyba że UMIEM_FAKE_PROVIDERS=1.
OPENAI_API_KEY=

# Nadpisują model generujący materiał (zestawy słówek i pule ćwiczeń lekcji),
# też tylko worker. Wszystkie opcjonalne i niezależne: bez nich gpt-4o-mini
# na https://api.openai.com/v1 z kluczem OPENAI_API_KEY. UMIEM_LLM_API_KEY
# nadpisuje klucz wyłącznie dla LLM — OPENAI_API_KEY pozostaje wymagany dla
# TTS i obrazów. BASE_URL musi być https:// poza NODE_ENV test/development.
# Uwaga: sam BASE_URL bez własnego API_KEY kieruje klucz OPENAI_API_KEY
# (nagłówek Authorization) na wskazany endpoint — ustawiaj tylko zaufane URL-e.
#UMIEM_LLM_MODEL=gpt-4o-mini
#UMIEM_LLM_BASE_URL=https://api.openai.com/v1
#UMIEM_LLM_API_KEY=

# Opcje pośrednika OpenRouter (wymagają BASE_URL na openrouter.ai — przy innym
# endpoincie start kończy się błędem konfiguracji). Ten sam zestaw z prefiksem UMIEM_GRADER_
# dotyczy gradera i oceny aktywności (proces web).
# REASONING: off | minimal | low | medium | high (nie każdy model pozwala na off).
# PROVIDER_*: routing do dostawców modelu; ustawienie dowolnej opcji wymusza
# dostawców obsługujących wysyłane parametry (ścisły json_schema puli lekcji).
# PROVIDER_DATA_COLLECTION=deny wyklucza dostawców zbierających dane z zapytań
# niezależnie od ustawień konta — zalecane dla gradera (odpowiedzi dzieci).
#UMIEM_LLM_REASONING=off
#UMIEM_LLM_PROVIDER_ORDER=Nebius,DeepInfra
#UMIEM_LLM_PROVIDER_QUANTIZATIONS=fp8
#UMIEM_LLM_PROVIDER_ALLOW_FALLBACKS=false
#UMIEM_LLM_PROVIDER_DATA_COLLECTION=deny

# Tylko worker: maksymalny czas jednego requestu i całej wielocelowej lekcji.
# Retry nie jest automatyczne po timeout; ręczne ponowienie tworzy nową próbę.
#UMIEM_LESSON_GENERATION_REQUEST_TIMEOUT_MS=90000
#UMIEM_LESSON_GENERATION_RUN_TIMEOUT_MS=600000
#UMIEM_LESSON_GENERATION_CANCEL_POLL_MS=1000

# Tylko web: Azure Speech — STT treści wypowiedzi + ocena wymowy (próby ustne).
# Bez obu wartości próby ustne kończą się wynikiem technicznym, nie fałszywą
# oceną. Region to identyfikator z Azure, np. westeurope.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Tylko web: model oceniający otwarte odpowiedzi lekcji (zgodny z OpenAI).
# Wszystkie trzy pierwsze albo żadna (częściowa konfiguracja = błąd startu).
# Bez nich niedopasowana odpowiedź tekstowa kończy się „nieocenione", a
# generowanie puli preferuje typy zamknięte. BASE_URL musi być https:// poza
# NODE_ENV test/development. Limity: timeout jednego wywołania i budżet wywołań
# na sesję (księgowany w learning_sessions.context.graderCalls).
UMIEM_GRADER_BASE_URL=
UMIEM_GRADER_API_KEY=
UMIEM_GRADER_MODEL=
#UMIEM_GRADER_TIMEOUT_MS=8000
#UMIEM_GRADER_MAX_CALLS_PER_SESSION=20
# Opcje pośrednika jak UMIEM_LLM_* wyżej (REASONING, PROVIDER_*).
#UMIEM_GRADER_REASONING=low
#UMIEM_GRADER_PROVIDER_DATA_COLLECTION=deny
# Dyktowanie odpowiedzi otwartych w zestawach szkolnych (bez oceny wymowy).
# Endpoint transkrypcji w formacie OpenAI (`/audio/transcriptions`); dla
# OpenRouter adapter zawsze wymusza Zero Data Retention. Brak = bez mikrofonu.
#UMIEM_LESSON_STT_BASE_URL=https://openrouter.ai/api/v1
#UMIEM_LESSON_STT_API_KEY=
#UMIEM_LESSON_STT_MODEL=elevenlabs/scribe-v2
# Osobny limit asynchronicznej oceny aktywności całej sesji (bez ponowień).
#UMIEM_SESSION_ACTIVITY_TIMEOUT_MS=60000

# ── Ustawienia medialne (nie sekrety) ────────────────────────────────────────
# Nazwy providerów/modeli wchodzą do fingerprintów zasobów mediów: web i worker
# muszą mieć identyczne wartości, a zmiana po wygenerowaniu materiału oznacza
# nową generację przy następnej edycji. Poniżej wartości domyślne z kodu.
UMIEM_TTS_PROVIDER=openai
UMIEM_TTS_MODEL=gpt-4o-mini-tts
UMIEM_TTS_VOICE=alloy
UMIEM_IMAGE_PROVIDER=openai
UMIEM_IMAGE_MODEL=gpt-image-2.5-sunburst
UMIEM_IMAGE_SIZE=1024x1024

# ── Tylko worker ─────────────────────────────────────────────────────────────
# Okres odpytywania kolejki zadań (ms).
WORKER_POLL_MS=2000
# Health jest 503, gdy od ostatniego zakończonego lub trwającego przelotu
# minęło więcej niż ten próg (ms); przed pierwszym poll loop jest zdrowy.
#WORKER_HEALTH_STALE_MS=900000

# Tryb bez sieciowych providerów (E2E, środowisko bez kluczy). Odkomentuj tylko
# celowo; zsh/PowerShell: usuń wiersz zamiast zostawiać pustej wartości.
#UMIEM_FAKE_PROVIDERS=1
#UMIEM_FAKE_DELAY_MS=3000

# ── Docker Compose (deploy/compose.yaml) ─────────────────────────────────────
# Hasło superusera PostgreSQL w kontenerze bazy; wymagane przez compose.
POSTGRES_PASSWORD=
# Nazwa bazy (domyślnie knowli) i port hosta aplikacji web (domyślnie 8080).
# HTTPS zapewnia reverse proxy przed webem (w domu Coolify) — sam compose
# wystawia zwykłe HTTP.
#POSTGRES_DB=knowli
#WEB_PORT=8080
# Compose wewnątrz kontenerów sam nadpisuje DATABASE_URL (db:5432) i MEDIA_ROOT
# (/data/media) — wartości z sekcji wyżej obowiązują tylko lokalny dev bez
# Dockera. Pozostałe zmienne (OPENAI/AZURE/UMIEM_*) compose przekazuje webowi
# i workerowi z tego jednego pliku, więc fingerprinty mediów zawsze się zgadzają.
