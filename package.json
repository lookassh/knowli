{
  "name": "knowli",
  "version": "0.1.0",
  "private": true,
  "description": "Knowli / Umiem! — prywatna, self-hostowana aplikacja rodzinna do nauki",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "eval:school-grader": "node apps/worker/node_modules/tsx/dist/cli.mjs scripts/evaluate-school-grader.mts",
    "eval:tts-styles": "node apps/worker/node_modules/tsx/dist/cli.mjs scripts/sample-tts-styles.mts",
    "eval:dictation-stt": "node apps/worker/node_modules/tsx/dist/cli.mjs scripts/evaluate-dictation-stt.mts",
    "check": "node scripts/check.cjs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "contracts:export-learning-overview": "node apps/worker/node_modules/tsx/dist/cli.mjs scripts/export-learning-overview-schema.ts",
    "test:mcp": "uv sync --locked --project integrations/umiem-mcp --group hermes-test && uv run --locked --project integrations/umiem-mcp --group hermes-test python -m unittest discover -s integrations/umiem-mcp/tests -p test_*.py",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "probe:chapter": "vitest run --config vitest.probe.config.ts tests/probes/chapter-generation.probe.test.ts",
    "probe:agent": "vitest run --config vitest.probe.config.ts tests/probes/agent-generation.probe.test.ts",
    "probe:gold": "vitest run --config vitest.probe.config.ts tests/probes/closed-check-gold.probe.test.ts",
    "probe:judge": "vitest run --config vitest.probe.config.ts tests/probes/blind/auto-judge.probe.test.ts",
    "probe:grading": "vitest run --config vitest.probe.config.ts tests/probes/grading.probe.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:shards": "node scripts/run-e2e-shards.cjs",
    "build": "node apps/web/node_modules/next/dist/bin/next build apps/web",
    "typecheck": "node scripts/typecheck.cjs",
    "media:regenerate-ui-audio": "pnpm --filter @learning/worker ui-audio:regenerate",
    "wt:setup": "node scripts/setup-worktree.cjs",
    "wt:clean": "node scripts/clean-worktrees.cjs",
    "hooks:install": "node scripts/install-git-hooks.cjs"
  },
  "dependencies": {
    "@learning/contracts": "workspace:*",
    "@learning/server": "workspace:*"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.15.0",
    "ai": "7.0.162",
    "jsdom": "26.1.0",
    "typescript": "^5.8.0",
    "typescript-native": "npm:typescript@7.0.2",
    "vitest": "^4.1.12",
    "zod": "4.6.5"
  },
  "pnpm": {
    "overrides": {
      "postcss@8.4.31": "8.5.29",
      "esbuild@0.18.20": "0.25.12",
      "fast-uri@<3.1.9": "3.1.9",
      "qs@<6.16.1": "6.16.1"
    }
  }
}
